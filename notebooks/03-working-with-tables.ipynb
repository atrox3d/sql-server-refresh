    "SET NOCOUNT ON;\n",
    "\n",
    "use master;\n",
    "select DB_NAME() as db_name;\n",
    "go\n",
    "\n",
    "USE [sample];\n",
    "SELECT DB_NAME() AS db_name;\n",
    "DECLARE @Msg NVARCHAR(MAX) = 'INFO | Initial Database Context: ' + DB_NAME();\n",
    "EXEC dbo.spInfo @Msg;\n",
    "GO\n"
   ]
